									"console.log(JSON.parse(pm.request.body.raw).mail);",
									"",
									"pm.collectionVariables.set('mail', JSON.parse(pm.request.body.raw).email);",
									"pm.collectionVariables.set('pass', JSON.parse(pm.request.body.raw).password);",
									"",
									"var jsonData = pm.response.json() ;",
									"pm.collectionVariables.set(\"userId\",jsonData.data.userId);",
									"",
									"pm.test(\"email\", function () {",
									"    var email = pm.collectionVariables.get(\"mail\"); ",
									"    var emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;",
									"    pm.expect(emailRegex.test(email)).to.be.true;",
									"});",
									"",
									"var schema = {",
									"",
									"\"type\": \"object\",",
									"  \"properties\": {",
									"  \"status\": {",
									"     \"type\": \"string\"",
									"   },",
									"    \"data\": {",
									"     \"type\": \"object\",",
									"     \"properties\": {",
									"       \"userId\": {",
									"         \"type\": \"integer\"",
									"       },",
									"       \"photoFilename\": {",
									"      \"type\": \"string\"",
									"        },",
