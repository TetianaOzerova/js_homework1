							"listen": "test",
							"script": {
								"exec": [
									"",
									"",
									"if (pm.response.code==! 200) console.log(pm.response.status);",
									"console.log(JSON.parse(pm.response.text()))",
									"if(pm.response.text().includes('status: \"ok\"')){",
									"    JSON.parse(pm.response.text())",
									"}",
									"else{",
									"    console.log(\"Tests stopped\");",
									"    // postman.setNextRequest(null);",
									"    pm.execution.setNextRequest(null);",
									"",
									"    const responseJson = pm.response.json();",
									"",
									"pm.test(\"Response status is OK\", () => {",
									"  pm.expect(responseJson.status).to.equal(\"ok\");",
									"});",
									"",
									"pm.test(\"Full response matches request body\", () => {",
									"  const requestBody = JSON.parse(pm.request.body.raw);",
									"  pm.expect(responseJson.data.name).to.equal(requestBody.name);",
									"  pm.expect(responseJson.data.lastName).to.equal(requestBody.lastName);",
									"  pm.expect(responseJson.data.country).to.equal(requestBody.country);",
									"",
									"  //  перевірка дати народження",
									"  const requestDateBirth = new Date(requestBody.dateBirth);",
									"  const responseDateBirth = new Date(responseJson.data.dateBirth);",
									"",
									"  pm.expect(responseDateBirth.getFullYear()).to.equal(requestDateBirth.getFullYear());",
									"  pm.expect(responseDateBirth.getMonth()).to.equal(requestDateBirth.getMonth());",
									"  pm.expect(responseDateBirth.getDate()).to.equal(requestDateBirth.getDate());",
									"});",
