	"item": [
		{
			"name": "Book ISBN Numbers",
			"item": [
				{
					"name": "Is Valid ISBN13 Number",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"//Status",
									"pm.test(\"Response status code is 200\", function () {",
									" pm.response.to.have.status(200);",
									"});",
									"",
									"//Headers",
									"pm.test(\"Content-Type is text/xml\", function () {",
									"pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/xml\");",
									"});",
									"",
									"pm.test(\"Header 'Content-Length' exists and has expected value\", function () {",
									"  pm.response.assert.hasHeader('Content-Length');",
									"  pm.expect(pm.response.headers.get('Content-Length')).to.be.a('string');",
									"  pm.expect(parseInt(pm.response.headers.get('Content-Length'), 10)).to.be.a('number');",
									"  pm.expect(pm.response.headers.get('Content-Length')).to.equal('302'); ",
									"});",
									"",
									"pm.test(\"Header 'Referrer-Policy' exists and has expected value\", function () {",
									"  pm.response.assert.hasHeader('Referrer-Policy');",
									"  pm.expect(pm.response.headers.get('Referrer-Policy')).to.equal('strict-origin-when-cross-origin');",
									"});",
									"",
									"   pm.test(\"Date header not empty\", function () {",
									"    pm.expect(pm.response.headers.get('Date')).to.exist;",
									"   });",
									"//Schema",
									"pm.test(\"Schema validation for the response body\", function () {",
									"  const responseData = xml2Json(pm.response.text());",
									"  ",
									"  pm.expect(responseData).to.have.property('soap:Envelope');",
									"  pm.expect(responseData['soap:Envelope']).to.have.property('$');",
									"  pm.expect(responseData['soap:Envelope']['$']).to.have.property('xmlns:soap', '');",
									"  pm.expect(responseData['soap:Envelope']).to.have.property('soap:Body');",
									"  pm.expect(responseData['soap:Envelope']['soap:Body']).to.have.property('m:IsValidISBN13Response');",
									"  pm.expect(responseData['soap:Envelope']['soap:Body']['m:IsValidISBN13Response']).to.have.property('$');",
									"  pm.expect(responseData['soap:Envelope']['soap:Body']['m:IsValidISBN13Response']['$']).to.have.property('xmlns:m', '');",
									"  pm.expect(responseData['soap:Envelope']['soap:Body']['m:IsValidISBN13Response']).to.have.property('m:IsValidISBN13Result');",
									"});",
									"//Body",
									"pm.test(\"Response has the required fields\", function () {",
									"    const responseData = xml2Json(pm.response.text());",
									"    ",
									"    pm.expect(responseData).to.be.an('object');",
									"    pm.expect(responseData).to.have.property('soap:Envelope');",
									"    pm.expect(responseData).to.have.property('soap:Body');",
									"    pm.expect(responseData).to.have.property('m:IsValidISBN13Response');",
									"    pm.expect(responseData).to.have.property('m:IsValidISBN13Result');",
									"});",
									"pm.test(\"Field data type is boolean-like\", function () {",
									"   var fieldValue = \"true\"; ",
									" pm.expect(fieldValue).to.be.a('string'); ",
									" pm.expect(fieldValue === \"true\" || fieldValue === \"false\").to.be.true; ",
									"",
									" pm.test(\"Field value is exactly 'true'\", function hhh() {",
									"  var fieldValue = \"true\"; ",
									"  pm.expect(fieldValue).to.equal(\"true\");",
									" });",
									"",
									"pm.test(\"Response body does not contain 'false' in expected field\", function () {",
									"  pm.response.assert.textIncludes(\"<m:IsValidISBN13Result>true<///m:IsValidISBN13Result>\"); ",
									"  pm.response.assert.textNotIncludes(\"<m:IsValidISBN13Result>false<///m:IsValidISBN13Result>\"); ",
									"});",
									"",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
